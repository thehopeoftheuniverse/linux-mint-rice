[global]
    monitor = 0
    follow = none
    width = 400
    height = 110
    origin = top-right
    offset = 12x48
    notification_limit = 4
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 340
    indicate_hidden = yes
    transparency = 4
    separator_height = 1
    padding = 14
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 1
    frame_color = "@BG_HL@"
    gap_size = 8
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = JetBrainsMono Nerd Font 10
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = off
    min_icon_size = 24
    max_icon_size = 48
    icon_path = /usr/share/icons/Papirus-Dark/16x16/status/:/usr/share/icons/Papirus-Dark/16x16/devices/
    sticky_history = yes
    history_length = 20
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 2
    ignore_dbusclose = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    background = "@BG@"
    foreground = "@FG@"
    highlight = "@BLUE@"

[urgency_low]
    background = "@BG_DARK@"
    foreground = "@FG_DIM@"
    frame_color = "@BG_HL@"
    timeout = 4

[urgency_normal]
    background = "@BG@"
    foreground = "@FG@"
    frame_color = "@BG_HL@"
    timeout = 6

[urgency_critical]
    background = "@BG@"
    foreground = "@FG@"
    frame_color = "@RED@"
    timeout = 0
