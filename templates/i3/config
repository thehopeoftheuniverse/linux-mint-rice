# ============================================================================
#  i3 · @THEME_NAME@  ·  generated by lib/render.py — edit templates/i3/config
#  Mod = Super (Windows key)
# ============================================================================
set $mod Mod4
set $term alacritty
set $menu rofi -show drun

font pango:JetBrainsMono Nerd Font 10

set $bg      @BG@
set $bg_dark @BG_DARK@
set $bg_hl   @BG_HL@
set $fg      @FG@
set $fg_dim  @FG_DIM@
set $muted   @MUTED@
set $accent  @BLUE@
set $accent2 @PURPLE@
set $urgent  @RED@
set $ok      @GREEN@

# ── geometry ────────────────────────────────────────────────────────────────
gaps inner 10
gaps outer 16
smart_gaps on
for_window [class=".*"] border pixel 2
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
title_align center
focus_follows_mouse yes
mouse_warping output
popup_during_fullscreen smart
workspace_auto_back_and_forth yes
force_display_urgency_hint 500 ms
default_orientation auto

# ── colours ─────────────────────────────────────────────────────────────────
client.focused          $accent  $accent  $bg_dark $accent2 $accent
client.focused_inactive $bg_hl   $bg_hl   $fg_dim  $bg_hl   $bg_hl
client.unfocused        $muted   $bg_dark $muted   $bg_hl   $muted
client.urgent           $urgent  $urgent  $bg_dark $urgent  $urgent
client.placeholder      $bg      $bg      $fg      $bg      $bg
client.background       $bg

# ── autostart ───────────────────────────────────────────────────────────────
exec_always --no-startup-id ~/.config/polybar/scripts/launch.sh
exec --no-startup-id picom --config ~/.config/picom/picom.conf
exec --no-startup-id ~/.config/i3/scripts/wallpaper.sh --restore --quiet
exec --no-startup-id dunst
exec --no-startup-id ~/.config/i3/scripts/clipboard-watch.sh
exec --no-startup-id xsettingsd
exec --no-startup-id numlockx on
exec --no-startup-id xsetroot -cursor_name left_ptr
exec --no-startup-id xss-lock -- ~/.config/i3/scripts/lock.sh
exec --no-startup-id sh -c 'command -v nm-applet >/dev/null && nm-applet --indicator'
exec --no-startup-id sh -c 'command -v blueman-applet >/dev/null && blueman-applet'
exec --no-startup-id sh -c 'command -v xfce4-power-manager >/dev/null && xfce4-power-manager --no-daemon'

# ── window rules ────────────────────────────────────────────────────────────
for_window [class="[Yy]ad"] floating enable, border pixel 2
for_window [class="[Pp]avucontrol"] floating enable, resize set 780 560, move position center
for_window [class="[Nn]m-connection-editor"] floating enable, resize set 820 600, move position center
for_window [class="[Bb]lueman-manager"] floating enable, resize set 720 560, move position center
for_window [class="[Ll]xappearance"] floating enable, resize set 640 520, move position center
for_window [class="[Ff]ile-roller"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [title="^(Open|Save|Choose) .*"] floating enable
for_window [title="File Operation Progress"] floating enable
for_window [class="[Pp]olybar"] border none

# ── launchers ───────────────────────────────────────────────────────────────
bindsym $mod+Return        exec $term
bindsym $mod+Shift+Return  exec $term --hold -e fastfetch
bindsym $mod+d             exec $menu
bindsym $mod+Tab           exec rofi -show window
bindsym $mod+Shift+d       exec rofi -show run
bindsym $mod+e             exec thunar ~
bindsym $mod+n             exec ~/.config/i3/scripts/network-menu.sh
bindsym $mod+v             exec ~/.config/i3/scripts/clipboard-pick.sh
bindsym $mod+Shift+n       exec ~/.config/i3/scripts/notif-history.sh
bindsym $mod+Shift+g       exec ~/.config/i3/scripts/toggle-gaps.sh
bindsym $mod+b             exec --no-startup-id polybar-msg cmd toggle
bindsym $mod+F2            exec alacritty --hold -e ~/.config/i3/scripts/rice-doctor.sh
bindsym $mod+F1            exec ~/.config/i3/scripts/cheatsheet.sh
bindsym $mod+Shift+w       exec ~/.config/i3/scripts/wallpaper-pick.sh
bindsym $mod+Alt+w         exec ~/.config/i3/scripts/wallpaper.sh --random
bindsym $mod+Shift+i       exec $term -e btop
bindsym $mod+c             exec $term -e cava

# ── window management ───────────────────────────────────────────────────────
bindsym $mod+q             kill
bindsym $mod+Shift+q       kill
bindsym $mod+f             fullscreen toggle
bindsym $mod+space         floating toggle
bindsym $mod+Shift+space   focus mode_toggle
bindsym $mod+grave         scratchpad show
bindsym $mod+Shift+grave   move scratchpad

# layouts
bindsym $mod+s             layout stacking
bindsym $mod+w             layout tabbed
bindsym $mod+Shift+s       layout toggle split
bindsym $mod+Shift+f       layout toggle split
bindsym $mod+a             focus parent

# focus
bindsym $mod+h             focus left
bindsym $mod+j             focus down
bindsym $mod+k             focus up
bindsym $mod+l             focus right
bindsym $mod+Left          focus left
bindsym $mod+Down          focus down
bindsym $mod+Up            focus up
bindsym $mod+Right         focus right

# move
bindsym $mod+Shift+h       move left
bindsym $mod+Shift+j       move down
bindsym $mod+Shift+k       move up
bindsym $mod+Shift+l       move right
bindsym $mod+Shift+Left    move left
bindsym $mod+Shift+Down    move down
bindsym $mod+Shift+Up      move up
bindsym $mod+Shift+Right   move right

# ── workspaces ──────────────────────────────────────────────────────────────
set $ws1 "@GLYPH_TERM@ 1"
set $ws2 "@GLYPH_WEB@ 2"
set $ws3 "@GLYPH_CODE@ 3"
set $ws4 "@GLYPH_PICTURE@ 4"
set $ws5 "@GLYPH_MUSIC@ 5"
set $ws6 "@GLYPH_FOLDER@ 6"
set $ws7 "@GLYPH_MAIL@ 7"
set $ws8 "@GLYPH_BOOK@ 8"
set $ws9 "@GLYPH_COGS@ 9"
set $ws10 "@GLYPH_BARS@ 10"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# ── screenshots ─────────────────────────────────────────────────────────────
bindsym Print              exec ~/.config/i3/scripts/screenshot.sh area
bindsym Shift+Print        exec ~/.config/i3/scripts/screenshot.sh full
bindsym $mod+Print         exec ~/.config/i3/scripts/screenshot.sh window

# ── session ─────────────────────────────────────────────────────────────────
bindsym $mod+Escape        exec ~/.config/i3/scripts/lock.sh
bindsym $mod+Shift+x       exec ~/.config/i3/scripts/powermenu.sh
bindsym $mod+Shift+c       reload
bindsym $mod+Shift+r       restart
bindsym $mod+Shift+e       exec ~/.config/i3/scripts/i3exit.sh logout

# ── audio / media ───────────────────────────────────────────────────────────
bindsym XF86AudioRaiseVolume  exec --no-startup-id ~/.config/i3/scripts/volume.sh up
bindsym XF86AudioLowerVolume  exec --no-startup-id ~/.config/i3/scripts/volume.sh down
bindsym XF86AudioMute         exec --no-startup-id ~/.config/i3/scripts/volume.sh mute
bindsym XF86AudioMicMute      exec --no-startup-id pamixer --default-source -t
bindsym $mod+Shift+m          exec --no-startup-id ~/.config/i3/scripts/volume.sh mute
bindsym XF86AudioPlay         exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext         exec --no-startup-id playerctl next
bindsym XF86AudioPrev         exec --no-startup-id playerctl previous
bindsym XF86AudioStop         exec --no-startup-id playerctl stop

# ── resize mode ─────────────────────────────────────────────────────────────
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left  resize shrink width 10 px or 10 ppt
    bindsym Down  resize grow height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# ── local overrides ─────────────────────────────────────────────────────────
# This file is yours: apply.sh and theme switching never touch it.
# Per-machine execs, extra binds and app autostarts belong here.
include ~/.config/i3/local.conf
