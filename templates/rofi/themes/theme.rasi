* {
    bg:            @BG@;
    bg-dark:       @BG_DARK@;
    bg-alt:        @BG_HL@;
    fg:            @FG@;
    fg-dim:        @FG_DIM@;
    muted:         @MUTED@;
    accent:        @ACCENT@;
    accent-alt:    @ACCENT_ALT@;
    urgent:        @RED@;

    font:             "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color:       @fg;
    border:           0;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            580px;
    location:         center;
    anchor:           center;
    background-color: @bg-dark;
    border:           1px;
    border-color:     @bg-alt;
    border-radius:    10px;
}

mainbox {
    background-color: transparent;
    padding:          16px;
    spacing:          12px;
    children:         [ inputbar, message, listview, mode-switcher ];
}

inputbar {
    background-color: @bg;
    border:           1px;
    border-color:     @bg-alt;
    border-radius:    8px;
    padding:          11px 14px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font Bold 11";
}

entry {
    text-color:         @fg;
    placeholder:        "type to search…";
    placeholder-color:  @muted;
    cursor:             text;
}

listview {
    lines:            8;
    columns:          1;
    spacing:          4px;
    scrollbar:        false;
    background-color: transparent;
    padding:          0px;
    fixed-height:     false;
    dynamic:          true;
}

element {
    padding:          9px 12px;
    spacing:          12px;
    border:           1px;
    border-color:     transparent;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @fg-dim;
}

element normal.normal    { background-color: transparent; text-color: @fg-dim; }
element alternate.normal { background-color: transparent; text-color: @fg-dim; }
element normal.urgent    { background-color: transparent; text-color: @urgent; }
element alternate.urgent { background-color: transparent; text-color: @urgent; }
element normal.active    { background-color: @bg;         text-color: @accent; }
element alternate.active { background-color: @bg;         text-color: @accent; }

element selected.normal {
    background-color: @bg-alt;
    text-color:       @fg;
    border:           1px;
    border-color:     @accent;
}

element selected.active {
    background-color: @bg-alt;
    text-color:       @accent-alt;
    border:           1px;
    border-color:     @accent-alt;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg-dark;
}

element-icon {
    size:   22px;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
    font:           "JetBrainsMono Nerd Font 11";
}

scrollbar {
    width:            4px;
    handle-color:     @accent;
    background-color: transparent;
    border-radius:    4px;
}

mode-switcher {
    background-color: @bg;
    border:           1px;
    border-color:     @bg-alt;
    border-radius:    8px;
    padding:          5px;
    spacing:          6px;
}

button {
    padding:          7px 12px;
    border:           1px;
    border-color:     transparent;
    border-radius:    6px;
    text-color:       @fg-dim;
    background-color: transparent;
    font:             "JetBrainsMono Nerd Font 10";
}

button selected {
    background-color: @bg-alt;
    text-color:       @accent;
    border:           1px;
    border-color:     @accent;
}

message {
    padding:          10px 14px;
    border-radius:    8px;
    background-color: @bg;
}

textbox {
    text-color: @fg;
}
