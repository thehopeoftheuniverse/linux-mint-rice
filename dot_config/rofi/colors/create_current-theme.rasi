/**
 * Default Active Rofi Theme: Catppuccin Mocha (Translucent Glass)
 **/

* {
    background:       #1e1e2ecc;
    background-solid: #11111bff;
    background-alt:   #313244b3;
    foreground:       #cdd6f4ff;
    selected:         #cba6f7ff;
    active:           #a6e3a1ff;
    urgent:           #f38ba8ff;
}
