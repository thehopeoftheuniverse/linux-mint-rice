! ── Xft ─────────────────────────────────────────────────────────────────
Xft.dpi:        96
Xft.antialias:  true
Xft.hinting:    true
Xft.hintstyle:  hintslight
Xft.rgba:       rgb
Xft.lcdfilter:  lcddefault

! ── cursor ───────────────────────────────────────────────────────────────
Xcursor.theme:  Bibata-Modern-Ice
Xcursor.size:   20

! ── urxvt / xterm fallback palette (@THEME_NAME@) ────────────────────────
*.foreground:   @FG@
*.background:   @BG@
*.cursorColor:  @BLUE@
*.color0:       @BG_HL@
*.color1:       @RED@
*.color2:       @GREEN@
*.color3:       @YELLOW@
*.color4:       @BLUE@
*.color5:       @PURPLE@
*.color6:       @CYAN@
*.color7:       @FG@
*.color8:       @MUTED@
