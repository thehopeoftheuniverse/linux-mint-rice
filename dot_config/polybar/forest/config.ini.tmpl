;; ┌────────────────────────────────────────────────────────────┐
;; │ Polybar Configuration (Debian / Linux Mint / Multi-Theme)  │
;; └────────────────────────────────────────────────────────────┘

{{ $host := index .hosts .chezmoi.hostname | default .hosts.default }}

[global/wm]
margin-bottom = 0
margin-top = 0

include-file = modules-bars.ini
include-file = current-theme.ini
include-file = current-layout.ini
include-file = modules.ini
include-file = user_modules.ini

[bar/main]
dpi = ${xrdb:Xft.dpi:-96}
monitor = ${env:POLYBAR_MONITOR:}
monitor-fallback =
monitor-strict = false
override-redirect = false

bottom = ${layout.bottom}
fixed-center = true

width = ${layout.width}
height = {{ $host.polybar_height }}
offset-x = ${layout.offset-x}
offset-y = ${layout.offset-y}

background = ${color.background}
foreground = ${color.foreground}

radius = ${layout.radius}

line-size = ${layout.line-size}
line-color = ${color.accent}

border-size = ${layout.border-size}
border-color = ${layout.border-color}

padding = ${layout.padding}
module-margin-left = 1
module-margin-right = 1

font-0 = "JetBrainsMono Nerd Font:size=10;3"
font-1 = "Iosevka Nerd Font:size=11;3"
font-2 = "JetBrainsMono Nerd Font:size=12;3"
font-3 = "JetBrainsMono Nerd Font:style=Bold:size=12;3"
font-4 = "JetBrainsMono Nerd Font:size=15;3"
font-5 = "JetBrainsMono Nerd Font:size=12;3"

{{ if gt $host.monitor_count 1 -}}
modules-left = launcher sep i3
modules-center = title
{{ else }}
modules-left = launcher sep i3 sep title
modules-center = date
{{ end }}

modules-right = bluetooth network battery_auto updates sep volume backlight sep theme-switch powermenu systray

separator =
dim-value = 1.0
wm-name = i3
locale =
wm-restack = i3
enable-ipc = true

cursor-click = pointer
cursor-scroll = ns-resize

[bar/minimal]
inherit = bar/main
modules-left = launcher sep i3
modules-center = date
modules-right = network volume theme-switch powermenu systray

[bar/side]
inherit = bar/main
monitor = "{{ $host.side_monitor_name }}"
modules-right = systray
modules-left = i3 sep cpu temperature cpu-fan case-fan memory sep gpu-usage vram gpu-temperature gpu-fan
modules-center =

[bar/left]
inherit = bar/main
monitor = "{{ $host.leftside_monitor_name }}"
modules-right = sep i3
modules-left =
modules-center = date

[bar/aux]
inherit = bar/main
monitor = ${env:POLYBAR_MONITOR:}
height = {{ $host.polybar_aux_height }}
bottom = true
offset-y = 0
modules-right = systray
modules-left = cpu temperature memory sep gpu-usage vram gpu-temperature
modules-center =

[settings]
throttle-output = 5
throttle-output-for = 10
screenchange-reload = true
compositing-background = source
compositing-foreground = over
compositing-overline = over
compositing-underline = over
compositing-border = over
pseudo-transparency = false
