#!/usr/bin/env bash
set -u

{{ $host := index .hosts .chezmoi.hostname | default .hosts.default }}

LOCK_FILE="/tmp/polybar-launch-${UID}.lock"
exec 9>"$LOCK_FILE"
if command -v flock >/dev/null 2>&1; then
  flock -w 10 9 || exit 1
fi

dir="$HOME/.config/polybar"
state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/ui-theme"
style="forest"
cfg_path="$dir/$style/config.ini"

# Auto-detect CPU temperature sensor (AMD k10temp/zenpower, Intel coretemp, or ACPI thermal)
for sensor in k10temp zenpower coretemp thinkpad acpitz; do
  for hw in /sys/class/hwmon/hwmon*; do
    if [[ -r "$hw/name" && "$(<"$hw/name")" == "$sensor" ]]; then
      for inp in "$hw"/temp*_input; do
        if [[ -r "$inp" ]]; then
          export CPU_TEMP_PATH="$inp"
          break 3
        fi
      done
    fi
  done
done
if [[ -z "${CPU_TEMP_PATH:-}" ]]; then
  for inp in /sys/class/hwmon/hwmon*/temp*_input; do
    if [[ -r "$inp" ]]; then
      export CPU_TEMP_PATH="$inp"
      break
    fi
  done
fi

# Auto-detect primary monitor (honor host config only if that output is connected)
cfg_mon="{{ $host.main_monitor_name }}"
if command -v xrandr >/dev/null 2>&1; then
  connected="$(xrandr --query | awk '/ connected/{print $1}')"
  if [[ -n "$cfg_mon" ]] && grep -qx "$cfg_mon" <<< "$connected"; then
    export POLYBAR_MONITOR="$cfg_mon"
  else
    primary="$(xrandr --query | awk '/ connected primary/{print $1; exit}')"
    export POLYBAR_MONITOR="${primary:-$(head -n1 <<< "$connected")}"
  fi
fi

# Auto-detect active network interface
cfg_net="{{ $host.network_interface_name }}"
if [[ -n "$cfg_net" && -d "/sys/class/net/$cfg_net" ]]; then
  export POLYBAR_NET_IFACE="$cfg_net"
else
  default_iface="$(ip route show default 2>/dev/null | awk '/default/{print $5; exit}')"
  if [[ -n "$default_iface" ]]; then
    export POLYBAR_NET_IFACE="$default_iface"
  else
    for net in /sys/class/net/*; do
      name="$(basename "$net")"
      [[ "$name" == "lo" ]] && continue
      export POLYBAR_NET_IFACE="$name"
      break
    done
  fi
fi

# Auto-detect battery & AC adapter
for ps in /sys/class/power_supply/*; do
  [[ -r "$ps/type" ]] || continue
  ptype="$(<"$ps/type")"
  pname="$(basename "$ps")"
  if [[ "$ptype" == "Battery" && -z "${POLYBAR_BATTERY:-}" && "$pname" == BAT* ]]; then
    export POLYBAR_BATTERY="$pname"
  elif [[ "$ptype" == "Mains" && -z "${POLYBAR_ADAPTER:-}" ]]; then
    export POLYBAR_ADAPTER="$pname"
  fi
done

# Auto-detect backlight device
has_backlight=0
for bl in /sys/class/backlight/*; do
  if [[ -d "$bl" ]]; then
    export POLYBAR_BACKLIGHT="$(basename "$bl")"
    has_backlight=1
    break
  fi
done

# Runtime config adapter:
# - Strips `backlight` when no backlight device exists (prevents desktop error spam)
# - Rewrites `internal/tray` for Polybar < 3.7 (Debian 12 / Mint 21)
pb_ver="$(polybar --version 2>/dev/null | sed -nE 's/^polybar ([0-9]+\.[0-9]+).*/\1/p' | head -n1 || true)"
is_legacy_pb=0
if [[ -n "$pb_ver" ]]; then
  major="${pb_ver%%.*}"
  minor="${pb_ver#*.}"
  if (( major < 3 || (major == 3 && minor < 7) )); then
    is_legacy_pb=1
  fi
fi

if (( is_legacy_pb == 1 || has_backlight == 0 )) && command -v python3 >/dev/null 2>&1; then
  compat_dir="/tmp/polybar-compat-${UID}"
  rm -rf "$compat_dir"
  mkdir -p "$compat_dir"
  cp -a "$dir/$style/." "$compat_dir/"
  python3 - "$compat_dir" "$is_legacy_pb" "$has_backlight" <<'PY'
import re, sys
from pathlib import Path

root = Path(sys.argv[1])
legacy = sys.argv[2] == "1"
has_bl = sys.argv[3] == "1"
cfg = root / "config.ini"
mods = root / "modules.ini"

if legacy and mods.exists():
    mt = mods.read_text(encoding="utf-8")
    mt = re.sub(r"\n\[module/systray\].*?(?=\n\[|\Z)", "\n", mt, flags=re.S)
    mods.write_text(mt, encoding="utf-8")

if cfg.exists():
    ct = cfg.read_text(encoding="utf-8")
    if not has_bl:
        ct = re.sub(r"\bbacklight\b[ \t]*", "", ct)
    if legacy:
        ct = re.sub(r"\bsystray\b", "", ct)
        ct = re.sub(
            r"^(modules-right\s*=.*)$",
            r"\1\ntray-position = right\ntray-maxsize = 16\ntray-padding = 4\ntray-background = ${color.background}",
            ct,
            count=1,
            flags=re.M,
        )
    cfg.write_text(ct, encoding="utf-8")
PY
  cfg_path="$compat_dir/config.ini"
fi

# Read chosen bar mode from UI state (sleek | floating | minimal | telemetry)
bar_mode="sleek"
if [[ -r "$state_dir/bar-layout" ]]; then
  bar_mode="$(tr -d '[:space:]' < "$state_dir/bar-layout")"
fi

case "${1:-}" in
  --minimal) bar_mode="minimal" ;;
  --telemetry) bar_mode="telemetry" ;;
  --floating) bar_mode="floating" ;;
  --sleek) bar_mode="sleek" ;;
esac

# Terminate already running bar instances (without requiring psmisc/killall)
pkill -u "$UID" -x polybar 2>/dev/null || true
pkill -u "$UID" -f "$dir/$style/scripts/updates.sh" 2>/dev/null || true
tries=0
while pgrep -u "$UID" -x polybar >/dev/null 2>&1 && (( tries < 25 )); do
  sleep 0.1
  tries=$((tries + 1))
done
if pgrep -u "$UID" -x polybar >/dev/null 2>&1; then
  pkill -KILL -u "$UID" -x polybar 2>/dev/null || true
  sleep 0.1
fi

{{ if gt $host.monitor_count 1 -}}
polybar -q main -c "$cfg_path" 9>&- &
polybar -q side -c "$cfg_path" 9>&- &
polybar -q left -c "$cfg_path" 9>&- &
{{- else -}}
if [[ "$bar_mode" == "minimal" ]]; then
  polybar -q minimal -c "$cfg_path" 9>&- &
elif [[ "$bar_mode" == "telemetry" ]]; then
  polybar -q main -c "$cfg_path" 9>&- &
  polybar -q aux -c "$cfg_path" 9>&- &
else
  polybar -q main -c "$cfg_path" 9>&- &
fi
{{- end }}
exec 9>&-
