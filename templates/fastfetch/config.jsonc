{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": { "top": 1, "left": 3, "right": 5 },
    "color": { "1": "bright_blue", "2": "magenta" }
  },
  "display": {
    "separator": "  ",
    "key": { "type": "icon", "padding": 1 },
    "color": { "keys": "blue", "title": "magenta", "output": "white" },
    "percent": { "type": 1 }
  },
  "modules": [
    { "type": "title", "keyColor": "magenta" },
    "separator",
    { "type": "os", "key": "os", "format": "{3} {12}" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "pkgs" },
    { "type": "wm", "key": "wm" },
    { "type": "wmtheme", "key": "theme" },
    { "type": "shell", "key": "shell" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu", "key": "cpu", "format": "{1} ({6})" },
    { "type": "gpu", "key": "gpu", "format": "{1}" },
    { "type": "memory", "key": "mem" },
    { "type": "disk", "key": "disk", "folders": "/" },
    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
