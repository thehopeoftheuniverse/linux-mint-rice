configuration {
    modi:               "drun,run,window,keys";
    show-icons:         true;
    icon-theme:         "Papirus-Dark";
    drun-display-format:"{name}";
    display-drun:       "@GLYPH_SEARCH@  apps";
    display-run:        "@GLYPH_TERM@  run";
    display-window:     "@GLYPH_BARS@  windows";
    display-keys:       "@GLYPH_BOLT@  keys";
    terminal:           "alacritty";
    font:               "JetBrainsMono Nerd Font 11";
    sort:               true;
    case-smart:         true;
    matching:           "fuzzy";
    drun-match-fields:  "name,generic,exec,categories,keywords";
    click-to-exit:      true;
}

@import "themes/theme.rasi"
