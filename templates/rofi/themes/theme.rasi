* {
    bg:            @BG@ee;
    bg-solid:      @BG@;
    bg-alt:        @BG_HL@;
    fg:            @FG@;
    fg-dim:        @FG_DIM@;
    muted:         @MUTED@;
    accent:        @BLUE@;
    accent-alt:    @PURPLE@;
    urgent:        @RED@;

    background-color: transparent;
    text-color:       @fg;
    border:           0;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            620px;
    location:         center;
    anchor:           center;
    transparency:     "real";
    background-color: transparent;
    border-radius:    16px;
}

mainbox {
    background-color: @bg;
    border:           2px;
    border-color:     @bg-alt;
    border-radius:    16px;
    padding:          16px;
    spacing:          12px;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          12px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font 12";
}

entry {
    text-color:         @fg;
    placeholder:        "search…";
    placeholder-color:  @muted;
    cursor:             text;
}

listview {
    lines:            9;
    columns:          1;
    spacing:          4px;
    scrollbar:        false;
    background-color: transparent;
    fixed-height:     false;
    dynamic:          true;
}

element {
    padding:          10px 12px;
    spacing:          12px;
    border-radius:    10px;
    background-color: transparent;
    text-color:       @fg-dim;
}

element normal.normal  { background-color: transparent; text-color: @fg-dim; }
element alternate.normal { background-color: transparent; text-color: @fg-dim; }

element selected {
    background-color: @accent;
    text-color:       @bg-solid;
}

element selected.active { background-color: @accent; text-color: @bg-solid; }

element-icon {
    size:   24px;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    font:           "JetBrainsMono Nerd Font 11";
}

scrollbar {
    width:            4px;
    handle-color:     @accent;
    background-color: transparent;
    border-radius:    2px;
}

mode-switcher {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          6px;
    spacing:          6px;
}

button {
    padding:      8px 14px;
    border-radius: 8px;
    text-color:   @muted;
    background-color: transparent;
}

button selected {
    background-color: @accent;
    text-color:       @bg-solid;
}

message {
    padding:          12px;
    border-radius:    10px;
    background-color: @bg-alt;
}

textbox {
    text-color: @fg;
}
