new_tab System Management
#Monitoring terminal setup
layout tall
#Launch cpu monitoring
launch sh -c 'exec btop -p 1'
#Launch gpu monitoring (fallback to btop if nvtop is not installed)
launch sh -c 'if command -v nvtop >/dev/null 2>&1; then exec nvtop; else exec btop -p 0; fi'
#Launch memory monitoring
launch sh -c 'exec btop -p 2'
#Launch net monitoring
launch sh -c 'exec btop -p 4'
#Process management tab
new_tab Process Management
layout tall
launch sh -c 'exec btop -p 3'
launch sh -c 'exec btop -p 2'
launch sh -c 'exec btop -p 1'
#File management setup
new_tab Disk Cleanup
launch sh -c 'if command -v ncdu >/dev/null 2>&1; then printf "Disk Cleanup: press Enter to scan ~ (or type a path such as /): "; read -r p; exec ncdu "${p:-$HOME}"; else echo "ncdu is not installed"; exec "${SHELL:-bash}"; fi'
